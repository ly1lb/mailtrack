{
  "manifest_version": 3,
  "name": "MailTrack Pro (savas serveris)",
  "short_name": "MailTrack Pro",
  "version": "1.1.5",
  "description": "Gmail laiškų sekimas: atidarymai, nuorodų paspaudimai, priminimai. Duomenys – jūsų serveryje.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MailTrack Pro"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "declarativeNetRequest",
    "tabs"
  ],
  "host_permissions": [
    "https://mail.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "sha256.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ]
}